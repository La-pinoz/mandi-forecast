# Copy to .env and fill in. Never commit .env.
DATA_GOV_IN_API_KEY=
# Neon DIRECT connection string (Connect dialog with "Connection pooling" off; host has no "-pooler"),
# e.g. postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# The pooled URL does not keep session settings and must not be used for migrations or tests.
DATABASE_URL=
# Optional, for running the database tests locally. Tests only create and drop their own temporary
# schemas, but a separate database (or a local Postgres) is still the safer choice.
TEST_DATABASE_URL=
